---
import { topicSlug } from '../consts';

interface Props {
  topics: Array<{ name: string; count: number }>;
}

const { topics } = Astro.props;
---

<ul class="topic-list">
  {topics.map((topic) => (
    <li>
      <a href={`/topics/${topicSlug(topic.name)}/`}>
        <span>{topic.name}</span>
        <span class="topic-count">{String(topic.count).padStart(2, '0')}</span>
      </a>
    </li>
  ))}
</ul>
