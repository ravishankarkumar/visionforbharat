---
import type { CollectionEntry } from 'astro:content';
import { formatDate, slugify } from '../consts';

interface Props {
  proposal: CollectionEntry<'proposals'>;
  index?: number;
}

const { proposal, index } = Astro.props;
const { title, summary, domains, publishedAt, updatedAt } = proposal.data;
---

<article class="proposal-card">
  {index && <span class="proposal-number" aria-hidden="true">{String(index).padStart(2, '0')}</span>}
  <div class="proposal-card-body">
    <div class="eyebrow-row">
      <a class="topic-link" href={`/themes/${slugify(domains[0])}/`}>{domains[0]}</a>
    </div>
    <h3><a href={`/ideas/${proposal.id}/`}>{title}</a></h3>
    <p>{summary}</p>
    <div class="card-meta">
      <span>Created <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>{updatedAt && <> · Updated <time datetime={updatedAt.toISOString()}>{formatDate(updatedAt)}</time></>}</span>
      <a class="read-link" href={`/ideas/${proposal.id}/`} aria-label={`Read ${title}`}>
        Read idea <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</article>
