---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProposalCard from '../components/ProposalCard.astro';
import EditorialCard from '../components/EditorialCard.astro';
import TopicList from '../components/TopicList.astro';
import heroImage from '../assets/images/vision-2075-hero.png';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const proposals = (await getCollection('proposals', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const featured = proposals.filter((proposal) => proposal.data.featured);
const latestEssays = (await getCollection('editorials', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
const topicCounts = new Map<string, number>();
for (const proposal of proposals) {
  for (const domain of proposal.data.domains) topicCounts.set(domain, (topicCounts.get(domain) ?? 0) + 1);
}
const topics = [...topicCounts].map(([name, count]) => ({ name, count }));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_TITLE,
  url: Astro.site,
  description: SITE_DESCRIPTION,
};
---

<BaseLayout>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="kicker">A long-view civic journal</p>
        <h1>Ideas for <span>Bharat, 2075.</span></h1>
        <p class="hero-deck">A personal collection of ideas, essays, and questions worth carrying into India’s future.</p>
        <p class="hero-manifesto">Written at leisure, without a party line, institutional brief, or fixed publishing schedule.</p>
        <a class="text-link" href="/about/">Why 2075 <span aria-hidden="true">→</span></a>
      </div>
      <figure class="hero-figure">
        <Picture
          src={heroImage}
          formats={['avif', 'webp']}
          widths={[480, 760, 1100, 1500]}
          sizes="(max-width: 800px) calc(100vw - 28px), 58vw"
          alt="An open book becomes pathways connecting farms, waterways, clean energy, research, transport, and cities at dawn."
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>Ideas, patiently recorded, can become public systems over generations.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section section-tinted" aria-labelledby="featured-title">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="kicker">Featured ideas</p>
          <h2 id="featured-title">A few places to begin.</h2>
        </div>
        <p>Thoughts across work, public experience, and democratic life. Each can stand on its own, change over time, or lead somewhere unexpected.</p>
      </div>
      <div class="proposal-list">
        {featured.map((proposal, index) => <ProposalCard proposal={proposal} index={index + 1} />)}
      </div>
    </div>
  </section>

  {latestEssays.length > 0 && (
    <section class="section" aria-labelledby="essays-title">
      <div class="shell">
        <div class="section-heading">
          <div><p class="kicker">Latest essays</p><h2 id="essays-title">A spark or a deep dive.</h2></div>
          <p>Short sparks and longer reflections, recorded at whatever length the thought seems to need.</p>
        </div>
        <div class="editorial-list">{latestEssays.map((essay, index) => <EditorialCard editorial={essay} index={index + 1} />)}</div>
        <a class="text-link" href="/essays/">Browse all essays <span aria-hidden="true">→</span></a>
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="topics-title">
    <div class="shell topics-section">
      <div><p class="kicker">Explore the connections</p><h2 id="topics-title">Ideas by theme.</h2></div>
      <TopicList topics={topics} />
    </div>
  </section>
</BaseLayout>
