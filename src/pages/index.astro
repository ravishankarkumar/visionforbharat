---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProposalCard from '../components/ProposalCard.astro';
import TopicList from '../components/TopicList.astro';
import heroImage from '../assets/images/vision-2075-hero.png';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const proposals = (await getCollection('proposals', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const featured = proposals.filter((proposal) => proposal.data.featured);
const topicCounts = new Map<string, number>();
for (const proposal of proposals) {
  for (const topic of proposal.data.topics) topicCounts.set(topic, (topicCounts.get(topic) ?? 0) + 1);
}
const topics = [...topicCounts].map(([name, count]) => ({ name, count }));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_TITLE,
  url: Astro.site,
  description: SITE_DESCRIPTION,
};
---

<BaseLayout>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="kicker">A long-view civic journal</p>
        <h1>Ideas for <span>Bharat, 2075.</span></h1>
        <p class="hero-deck">A quiet repository of constructive ideas, structural blueprints, and questions worth carrying into India’s future.</p>
        <p class="hero-manifesto">Not a campaign. Not an appeal to today’s power. This is an intellectual seed-bank for reforms that may matter long after the noise of the present has settled.</p>
        <a class="text-link" href="/about/">Why 2075 <span aria-hidden="true">→</span></a>
      </div>
      <figure class="hero-figure">
        <Picture
          src={heroImage}
          formats={['avif', 'webp']}
          widths={[480, 760, 1100, 1500]}
          sizes="(max-width: 800px) calc(100vw - 28px), 58vw"
          alt="An open book becomes pathways connecting farms, waterways, clean energy, research, transport, and cities at dawn."
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>Ideas, patiently recorded, can become public systems over generations.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section section-tinted" aria-labelledby="foundations-title">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="kicker">Day-one foundations</p>
          <h2 id="foundations-title">Three places to begin.</h2>
        </div>
        <p>Early proposals across work, mobility, and democratic administration. Each is a starting point for scrutiny—not a finished answer.</p>
      </div>
      <div class="proposal-list">
        {featured.map((proposal, index) => <ProposalCard proposal={proposal} index={index + 1} />)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="reading-title">
    <div class="shell principles-grid">
      <div class="principles-copy">
        <p class="kicker">How to read this journal</p>
        <h2 id="reading-title">Conviction, with room for correction.</h2>
        <p class="muted">A proposal earns trust by showing its assumptions and limits—not by sounding certain.</p>
        <a class="text-link" href="/method/">Read the editorial method <span aria-hidden="true">→</span></a>
      </div>
      <ol class="principle-list">
        <li><h3>Start with the public problem</h3><p>Describe who experiences it, how it works today, and what remains uncertain.</p></li>
        <li><h3>Make the mechanism visible</h3><p>Explain how an idea might move from aspiration to administration.</p></li>
        <li><h3>Invite the strongest objection</h3><p>Costs, federal tensions, incentives, and unintended effects belong in the proposal.</p></li>
        <li><h3>Keep a revision trail</h3><p>Important changes should remain visible so that learning does not look like inconsistency.</p></li>
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="topics-title">
    <div class="shell topics-section">
      <div><p class="kicker">Explore the questions</p><h2 id="topics-title">Ideas by domain.</h2></div>
      <TopicList topics={topics} />
    </div>
  </section>
</BaseLayout>
