---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProposalCard from '../../components/ProposalCard.astro';

export async function getStaticPaths() {
  const proposals = await getCollection('proposals', ({ data }) => !data.draft);
  const seriesMap = new Map<string, { name: string; slug: string; parentId?: string }>();
  for (const proposal of proposals) {
    const series = proposal.data.series;
    if (series) seriesMap.set(series.slug, { name: series.name, slug: series.slug, parentId: series.parentId });
  }
  return [...seriesMap.values()].map((series) => ({
    params: { series: series.slug },
    props: {
      series,
      parent: proposals.find((proposal) => proposal.id === series.parentId),
      entries: proposals
        .filter((proposal) => proposal.data.series?.slug === series.slug)
        .sort((a, b) => (a.data.series?.order ?? 999) - (b.data.series?.order ?? 999)),
    },
  }));
}

interface Props {
  series: { name: string; slug: string; parentId?: string };
  parent?: CollectionEntry<'proposals'>;
  entries: CollectionEntry<'proposals'>[];
}
const { series, parent, entries } = Astro.props;
---

<BaseLayout title={`${series.name} series`} description={`The ${series.name} foundation and its practical case studies.`}>
  <header class="page-intro"><div class="shell"><p class="kicker">Idea series</p><h1>{series.name}</h1><p class="lead">A broad principle explored through concrete systems and citizen experiences.</p></div></header>
  <div class="catalogue shell">
    {parent && <section class="catalogue-group" aria-labelledby="foundation-title"><div class="catalogue-heading"><div><p class="kicker">Foundation</p><h2 id="foundation-title">The governing idea</h2></div></div><div class="proposal-list"><ProposalCard proposal={parent} /></div></section>}
    <section class="catalogue-group" aria-labelledby="case-studies-title"><div class="catalogue-heading"><div><p class="kicker">Case studies</p><h2 id="case-studies-title">Testing the principle</h2></div><span>{String(entries.length).padStart(2, '0')}</span></div><div class="proposal-list">{entries.map((entry, index) => <ProposalCard proposal={entry} index={index + 1} />)}</div></section>
  </div>
</BaseLayout>
