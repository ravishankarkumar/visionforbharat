---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const proposals = await getCollection('proposals', ({ data }) => !data.draft);
const seriesMap = new Map<string, { name: string; slug: string; count: number; parentId?: string }>();
for (const proposal of proposals) {
  const series = proposal.data.series;
  if (!series) continue;
  const current = seriesMap.get(series.slug);
  seriesMap.set(series.slug, { name: series.name, slug: series.slug, parentId: series.parentId, count: (current?.count ?? 0) + 1 });
}
const allSeries = [...seriesMap.values()].sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout title="Idea series" description="Explore connected foundations and their case studies.">
  <header class="page-intro"><div class="shell"><p class="kicker">Connected thinking</p><h1>Idea series.</h1><p class="lead">Broad foundations become useful when tested against specific systems, institutions, and citizen journeys.</p></div></header>
  <section class="archive shell" aria-label="All idea series">
    <ul class="domain-grid">
      {allSeries.map((series) => <li><a href={`/series/${series.slug}/`}><span>{series.name}</span><small>{series.count} {series.count === 1 ? 'case study' : 'case studies'}</small></a></li>)}
    </ul>
    <p class="catalogue-footnote"><a href="/ideas/">Return to the complete catalogue →</a></p>
  </section>
</BaseLayout>
