---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { slugify } from '../../consts';

const proposals = await getCollection('proposals', ({ data }) => !data.draft);
const counts = new Map<string, number>();
for (const proposal of proposals) for (const domain of proposal.data.domains) counts.set(domain, (counts.get(domain) ?? 0) + 1);
const domains = [...counts].sort(([a], [b]) => a.localeCompare(b));
---

<BaseLayout title="Domains" description="Explore the Vision for Bharat catalogue by area of public life.">
  <header class="page-intro"><div class="shell"><p class="kicker">Browse the catalogue</p><h1>Domains of public life.</h1><p class="lead">An idea may cross several institutions, but each begins in at least one recognisable area of public life.</p></div></header>
  <section class="archive shell" aria-label="All domains">
    <ul class="domain-grid">
      {domains.map(([domain, count]) => <li><a href={`/domains/${slugify(domain)}/`}><span>{domain}</span><small>{count} {count === 1 ? 'idea' : 'ideas'}</small></a></li>)}
    </ul>
    <p class="catalogue-footnote"><a href="/series/">Browse idea series →</a></p>
  </section>
</BaseLayout>
