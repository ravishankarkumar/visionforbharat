---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProposalCard from '../../components/ProposalCard.astro';
import { topicSlug } from '../../consts';

export async function getStaticPaths() {
  const proposals = await getCollection('proposals', ({ data }) => !data.draft);
  const topics = new Set(proposals.flatMap((proposal) => proposal.data.topics));
  return [...topics].map((topic) => ({
    params: { topic: topicSlug(topic) },
    props: { topic, proposals: proposals.filter((proposal) => proposal.data.topics.includes(topic)) },
  }));
}

interface Props { topic: string; proposals: CollectionEntry<'proposals'>[] }
const { topic, proposals } = Astro.props;
---

<BaseLayout title={topic} description={`Ideas about ${topic.toLowerCase()} for India’s long-term future.`}>
  <header class="page-intro"><div class="shell"><p class="kicker">Domain</p><h1>{topic}</h1><p class="lead">Proposals and open questions connected to this area of public life.</p></div></header>
  <section class="archive shell" aria-label={`Ideas about ${topic}`}>
    <div class="archive-note"><span>{proposals.length} {proposals.length === 1 ? 'proposal' : 'proposals'}</span><a href="/ideas/">View the full archive</a></div>
    <div class="proposal-list">{proposals.map((proposal, index) => <ProposalCard proposal={proposal} index={index + 1} />)}</div>
  </section>
</BaseLayout>
