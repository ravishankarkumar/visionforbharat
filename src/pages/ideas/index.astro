---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProposalCard from '../../components/ProposalCard.astro';
import { slugify } from '../../consts';

const proposals = (await getCollection('proposals', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const themes = [...new Set(proposals.flatMap((proposal) => proposal.data.domains))].sort();
const horizons = [...new Set(proposals.flatMap((proposal) => proposal.data.horizons))].sort();
const places = [...new Set(proposals.flatMap((proposal) => proposal.data.places))].sort();
---

<BaseLayout title="Ideas" description="A growing, personal collection of ideas for India’s future.">
  <header class="page-intro">
    <div class="shell">
      <p class="kicker">Ideas</p>
      <h1>Things worth thinking about.</h1>
      <p class="lead">A personal collection of possibilities, questions, and changes I would like to explore—written whenever they feel worth recording.</p>
    </div>
  </header>
  <div class="catalogue-nav shell" aria-label="Browse the catalogue">
    <div><span>By theme</span>{themes.map((theme) => <a href={`/themes/${slugify(theme)}/`}>{theme}</a>)}</div>
    <div><span>By horizon</span>{horizons.map((horizon) => <a href={`/horizons/${horizon}/`}>{horizon}</a>)}</div>
    <div><span>By place</span>{places.map((place) => <a href={`/places/${slugify(place)}/`}>{place}</a>)}</div>
  </div>
  <section class="archive shell" aria-label="All ideas">
    <div class="archive-note"><span>{proposals.length} {proposals.length === 1 ? 'idea' : 'ideas'}</span></div>
    <div class="proposal-list">{proposals.map((proposal, index) => <ProposalCard proposal={proposal} index={index + 1} />)}</div>
  </section>
</BaseLayout>
