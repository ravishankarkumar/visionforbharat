---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import ProposalCard from '../components/ProposalCard.astro';
import { formatDate, STATUS_LABELS, topicSlug } from '../consts';

interface Props {
  proposal: CollectionEntry<'proposals'>;
  related: CollectionEntry<'proposals'>[];
}

const { proposal, related } = Astro.props;
const { title, summary, thesis, publishedAt, updatedAt, status, topics, changeNote } = proposal.data;
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: summary,
  datePublished: publishedAt.toISOString(),
  dateModified: (updatedAt ?? publishedAt).toISOString(),
  mainEntityOfPage: new URL(`/ideas/${proposal.id}/`, Astro.site).toString(),
  publisher: { '@type': 'Organization', name: 'Vision for Bharat' },
};
---

<BaseLayout title={title} description={summary} type="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <article class="article-shell">
    <header class="article-header shell narrow">
      <a class="back-link" href="/ideas/">← All ideas</a>
      <div class="eyebrow-row article-topics">
        {topics.map((topic, i) => (
          <>
            {i > 0 && <span>·</span>}
            <a class="topic-link" href={`/topics/${topicSlug(topic)}/`}>{topic}</a>
          </>
        ))}
      </div>
      <h1>{title}</h1>
      <p class="article-thesis">{thesis}</p>
      <dl class="article-meta">
        <div><dt>Status</dt><dd>{STATUS_LABELS[status]}</dd></div>
        <div><dt>Published</dt><dd><time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time></dd></div>
        {updatedAt && <div><dt>Revised</dt><dd><time datetime={updatedAt.toISOString()}>{formatDate(updatedAt)}</time></dd></div>}
      </dl>
      <div class="draft-note">
        <strong>A proposal in progress.</strong>
        <span>This essay records a direction for debate, not a final legislative design.</span>
      </div>
    </header>

    <div class="article-grid shell">
      <aside class="article-aside" aria-label="On this page">
        <p>On this page</p>
        <nav>
          <a href="#in-brief">In brief</a>
          <a href="#context">Context</a>
          <a href="#blueprint">The blueprint</a>
          <a href="#implementation">Implementation</a>
          <a href="#trade-offs">Trade-offs</a>
          <a href="#open-questions">Open questions</a>
        </nav>
        <button class="print-button" onclick="window.print()">Print / save PDF</button>
      </aside>
      <div class="article-body prose">
        <slot />
      </div>
    </div>

    {changeNote && (
      <section class="revision shell narrow" aria-labelledby="revision-title">
        <p class="kicker">Revision note</p>
        <h2 id="revision-title">How this idea has changed</h2>
        <p>{changeNote}</p>
      </section>
    )}

    {related.length > 0 && (
      <section class="related shell" aria-labelledby="related-title">
        <p class="kicker">Continue reading</p>
        <h2 id="related-title">Related ideas</h2>
        <div class="proposal-list compact">
          {related.map((item) => <ProposalCard proposal={item} />)}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
