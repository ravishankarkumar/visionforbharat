---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import ProposalCard from '../components/ProposalCard.astro';
import { formatDate, slugify } from '../consts';

interface Props {
  proposal: CollectionEntry<'proposals'>;
  related: CollectionEntry<'proposals'>[];
}

const { proposal, related } = Astro.props;
const { title, summary, publishedAt, updatedAt, domains, horizons, places } = proposal.data;
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: summary,
  datePublished: publishedAt.toISOString(),
  dateModified: (updatedAt ?? publishedAt).toISOString(),
  mainEntityOfPage: new URL(`/ideas/${proposal.id}/`, Astro.site).toString(),
  publisher: { '@type': 'Organization', name: 'Vision for Bharat' },
};
---

<BaseLayout title={title} description={summary} type="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <article class="article-shell">
    <header class="article-header shell narrow">
      <a class="back-link" href="/ideas/">← All ideas</a>
      <div class="eyebrow-row article-topics">
        {domains.map((domain, i) => (
          <>
            {i > 0 && <span>·</span>}
            <a class="topic-link" href={`/themes/${slugify(domain)}/`}>{domain}</a>
          </>
        ))}
      </div>
      <h1>{title}</h1>
      <p class="article-thesis">{summary}</p>
      <dl class="article-meta">
        <div><dt>Created</dt><dd><time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time></dd></div>
        <div><dt>Horizon</dt><dd>{horizons.map((horizon, i) => <>{i > 0 && ', '}<a href={`/horizons/${horizon}/`}>{horizon}</a></>)}</dd></div>
        <div><dt>Place</dt><dd>{places.map((place, i) => <>{i > 0 && ', '}<a href={`/places/${slugify(place)}/`}>{place}</a></>)}</dd></div>
        {updatedAt && <div><dt>Updated</dt><dd><time datetime={updatedAt.toISOString()}>{formatDate(updatedAt)}</time></dd></div>}
      </dl>
    </header>

    <div class="article-simple shell narrow">
      <div class="article-body prose">
        <slot />
      </div>
    </div>

    {related.length > 0 && (
      <section class="related shell" aria-labelledby="related-title">
        <p class="kicker">Continue reading</p>
        <h2 id="related-title">Related ideas</h2>
        <div class="proposal-list compact">
          {related.map((item) => <ProposalCard proposal={item} />)}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
